# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this example file is committed.

# Development: the browser calls the API's published port itself.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Production (docker-compose.prod.yml, set in Coolify): the backend's https
# address. The browser calls /api on this app and Next forwards it here.
# Compiled into the build, so changing it needs a redeploy.
API_PROXY_TARGET=https://backend-hardgoods-and-display.ai.dkcexportstna.in
